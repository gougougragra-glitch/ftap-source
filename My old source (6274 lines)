        if not FormS.active then FormS.resp = false return end
        task.wait(0.1) fw = fw + 0.1
        folder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end
    if not folder then FormS.resp = false return end

    local newPallet, wt = nil, 0
    while not newPallet and wt < 5 do
        if not FormS.active then FormS.resp = false return end
        task.wait(0.1) wt = wt + 0.1
        for _, obj in ipairs(folder:GetChildren()) do
            if obj.Name == "PalletLightBrown" and not existing[obj] then
                newPallet = obj break
            end
        end
    end
    if not newPallet then FormS.resp = false return end

    newPallet.Name = "ragdoll1"

    local ragdoll1 = formecomplet.waitForRagdoll()
    if not ragdoll1 then FormS.resp = false return end

    for _, child in pairs(ragdoll1:GetDescendants()) do
        if child:IsA("BasePart") then
            child.Transparency = 1
            child.CanCollide = false
            child.CanQuery = false
        end
    end

    task.wait(0.1)
    if not FormS.active then FormS.resp = false return end

    local sp = ragdoll1:FindFirstChild("SoundPart")
    if not sp or not sp:IsA("BasePart") then FormS.resp = false return end

    task.spawn(function()
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(sp, sp.CFrame)
        end)
    end)

    task.wait(0.1)
    if not FormS.active then FormS.resp = false return end

    formecomplet.startTPLoop()
    FormS.resp = false

    if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
    FormS.watch = ragdoll1.AncestryChanged:Connect(function(_, parent)
        if not FormS.active then return end
        if parent == nil then
            formecomplet.stopTPLoop()
            if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
            FormS.resp = false
            task.wait(0.5)
            if FormS.active then task.spawn(function() formecomplet.spawnAndSetup() end) end
        end
    end)

    task.wait(0.1)
    if not FormS.active then return end

    FormS.keepInFrontRunning = false
    task.wait(0)
    FormS.keepInFrontRunning = true

    task.spawn(function()
        local lastTarget = nil
        local cachedChar = nil
        local cachedHRP = nil
        local cachedHead = nil
        local cachedMyHRP = nil

        while FormS.keepInFrontRunning and FormS.isEnabled do
            task.wait(0.05)
            if not FormS.isEnabled or not FormS.keepInFrontRunning then break end
            if not FormS.selectedTarget or FormS.selectedTarget == "..." then continue end

            local myChar = LocalPlayer.Character
            if not myChar then continue end
            if not cachedMyHRP or not cachedMyHRP.Parent then
                cachedMyHRP = myChar:FindFirstChild("HumanoidRootPart")
            end
            if not cachedMyHRP then continue end

            local targetPlayer = Players:FindFirstChild(FormS.selectedTarget)
            if not targetPlayer then continue end

            local currentChar = targetPlayer.Character
            if not currentChar then continue end

            if lastTarget ~= FormS.selectedTarget or cachedChar ~= currentChar then
                lastTarget = FormS.selectedTarget
                cachedChar = currentChar
                cachedHRP = nil
                cachedHead = nil
                FormS.lastPlotCheckTime = 0
            end

            if not cachedHRP or not cachedHRP.Parent then cachedHRP = currentChar:FindFirstChild("HumanoidRootPart") end
            if not cachedHead or not cachedHead.Parent then cachedHead = currentChar:FindFirstChild("Head") end
            if not cachedHRP or not cachedHead then continue end

            if formecomplet.isTargetInPlot() then continue end

            local po = cachedHead:FindFirstChild("PartOwner")
            local isGrabbed = po and tostring(po.Value) == LocalPlayer.Name

            if isGrabbed then
                cachedHRP.AssemblyLinearVelocity = Vector3.zero
                cachedHRP.AssemblyAngularVelocity = Vector3.zero
            else
                local dist = (cachedMyHRP.Position - cachedHRP.Position).Magnitude

                if dist > 20 then
                    if not FormS.isBringing then
                        FormS.isBringing = true
                        local savedPos = cachedMyHRP.CFrame

                        task.spawn(function()
                            local bringConn
                            bringConn = game:GetService("RunService").Heartbeat:Connect(function()
                                if not FormS.isEnabled or not FormS.isBringing then
                                    bringConn:Disconnect()
                                    return
                                end
                                if cachedHRP and cachedHRP.Parent then
                                    cachedMyHRP.CFrame = cachedHRP.CFrame + Vector3.new(0, 3, 0)
                                end
                            end)

                            while FormS.isEnabled do
                                pcall(function()
                                    game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(cachedHRP, cachedHRP.CFrame)
                                end)
                                task.wait(0)
                                local p2 = cachedHead and cachedHead:FindFirstChild("PartOwner")
                                if p2 and tostring(p2.Value) == LocalPlayer.Name then
                                    bringConn:Disconnect()
                                    task.wait(0.1)
                                    cachedMyHRP.CFrame = savedPos
                                    task.wait(0.15)
                                    FormS.isBringing = false
                                    break
                                end
                            end

                            bringConn:Disconnect()
                            FormS.isBringing = false
                        end)
                    end
                else
                    pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(cachedHRP, cachedHRP.CFrame)
                    end)
                end
            end
        end

        FormS.keepInFrontRunning = false
    end)
end

