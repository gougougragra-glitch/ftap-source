function formecomplet.isTargetInPlot()
    if tick() - FormS.lastPlotCheckTime < 0.5 then return FormS.plotCheckCache end
    FormS.lastPlotCheckTime = tick()
    local plotItems = workspace:FindFirstChild("PlotItems")
    if not plotItems then FormS.plotCheckCache = false return false end
    local function check(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child.Name == FormS.selectedTarget then return true end
            if check(child) then return true end
        end
        return false
    end
    FormS.plotCheckCache = check(plotItems)
    return FormS.plotCheckCache
end

function formecomplet.tpAllParts(targetChar, positions)
    for _, partName in pairs(formecomplet.R6Parts) do
        local part = targetChar:FindFirstChild(partName)
        if part and positions[partName] then
            part.CFrame = positions[partName]
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

function formecomplet.restoreCollision()
    if not FormS.selectedTarget or FormS.selectedTarget == "..." then return end
