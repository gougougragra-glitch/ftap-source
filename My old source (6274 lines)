                            if distance > 28 then
                                local originalCFrame = lRoot.CFrame
                                lRoot.CFrame = tRoot.CFrame - Vector3.new(0, 5, 0)
                                
                                if RemoteSetNetworkOwner then RemoteSetNetworkOwner:FireServer(tRoot, tRoot.CFrame) end
                                if RemoteDestroyGrabLine then RemoteDestroyGrabLine:FireServer(tRoot) end
                                
