local function GetShapeOffset(angle)
    if CurrentShape == "Coeur" then
        local factor = ORBIT_RADIUS / 16
        local x = 16 * math.sin(angle)^3
        local y = 13 * math.cos(angle) - 5 * math.cos(2*angle) - 2 * math.cos(3*angle) - math.cos(4*angle)
        return Vector3.new(x * factor, (y * factor) + HEIGHT, -5)
        
    elseif CurrentShape == "Doigt" then
        local t = (angle % (math.pi * 2)) / (math.pi * 2)
        local totalSegments = #FingerPoints - 1
        local segmentProgression = t * totalSegments
        local index = math.floor(segmentProgression) + 1
        local alpha = segmentProgression - math.floor(segmentProgression)
        
        local p1 = FingerPoints[index]
        local p2 = FingerPoints[index + 1] or FingerPoints[1]
        local currentPoint = p1:Lerp(p2, alpha)
        
        local scale = ORBIT_RADIUS / 4.5
        return Vector3.new(currentPoint.X * scale, (currentPoint.Y * scale) + HEIGHT, -5)

    elseif CurrentShape == "Penis" then
        local t = (angle % (math.pi * 2)) / (math.pi * 2)
        local totalSegments = #PenisPoints - 1
        local segmentProgression = t * totalSegments
        local index = math.floor(segmentProgression) + 1
        local alpha = segmentProgression - math.floor(segmentProgression)
        
        local p1 = PenisPoints[index]
        local p2 = PenisPoints[index + 1] or PenisPoints[1]
        local currentPoint = p1:Lerp(p2, alpha)
        
        local scale = ORBIT_RADIUS / 5
        return Vector3.new(currentPoint.X * scale, (currentPoint.Y * scale) + HEIGHT, -5)

    elseif CurrentShape == "L" then
        local t = (angle % (math.pi * 2)) / (math.pi * 2)
        local totalSegments = #LPoints - 1
        local segmentProgression = t * totalSegments
        local index = math.floor(segmentProgression) + 1
        local alpha = segmentProgression - math.floor(segmentProgression)
        
        local p1 = LPoints[index]
        local p2 = LPoints[index + 1] or LPoints[1]
        local currentPoint = p1:Lerp(p2, alpha)
        
        local scale = ORBIT_RADIUS / 4
        return Vector3.new(currentPoint.X * scale, (currentPoint.Y * scale) + HEIGHT, -5)

    elseif CurrentShape == "67" then
        local t = (angle % (math.pi * 2)) / (math.pi * 2)
        local totalSegments = #Combined67Points - 1
        local segmentProgression = t * totalSegments
        local index = math.floor(segmentProgression) + 1
        local alpha = segmentProgression - math.floor(segmentProgression)
        
        local p1 = Combined67Points[index]
        local p2 = Combined67Points[index + 1] or Combined67Points[1]
        local currentPoint = p1:Lerp(p2, alpha)
        
        local scale = ORBIT_RADIUS / 5.5
        return Vector3.new(currentPoint.X * scale, (currentPoint.Y * scale) + HEIGHT, -5)
    else
        return Vector3.new(math.cos(angle) * ORBIT_RADIUS, HEIGHT, math.sin(angle) * ORBIT_RADIUS)
    end
end

local function GetAllActiveSticks()
    local sticks = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        local SpawnedToys = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
        if SpawnedToys then
            local rootPart = HumanoidRootPart 
            for _, Item in ipairs(SpawnedToys:GetChildren()) do
                if Item.Name == "FireworkSparkler" then
                    local Stick = Item:FindFirstChild("Stick")
                    if Stick and Stick:IsA("BasePart") then
                        local PartOwner = Stick:FindFirstChild("PartOwner")
                        
                        if PartOwner and PartOwner:IsA("StringValue") and PartOwner.Value ~= "Rawane2510" then
                            pcall(function() 
                                GrabEvents.SetNetworkOwner:FireServer(Stick, Stick.CFrame) 
                            end)
                        end
                        
                        if PartOwner and PartOwner:IsA("StringValue") and PartOwner.Value ~= "Rawane2510" then
                            local distance = (rootPart.Position - Stick.Position).Magnitude
                            if distance > 50 then 
                                pcall(function()
                                    local oldCFrame = rootPart.CFrame
                                    rootPart.CFrame = Stick.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.1)
                                    rootPart.CFrame = oldCFrame
                                end)
                            end
                        end
                        
                        table.insert(sticks, Stick)
                    end
                end
            end
        end
    end
    return sticks
end

