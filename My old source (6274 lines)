local function StartAutoSit()
    if Connection then Connection:Disconnect() end

    Connection = RunService.Heartbeat:Connect(function()
        if not AutoSit then
            if Connection then Connection:Disconnect() end
            return
        end

        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChild("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or humanoid.Health <= 0 then return end

        local toysFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        local blobman = toysFolder and toysFolder:FindFirstChild("CreatureBlobman")

        local seatIsTakenByOther = false
        if blobman then
            local seat = blobman:FindFirstChild("VehicleSeat")
            if seat and seat.Occupant and seat.Occupant ~= humanoid then
                seatIsTakenByOther = true
            end
        end

        if not blobman or seatIsTakenByOther then
            if seatIsTakenByOther and humanoid.SeatPart then
                humanoid.Sit = false
                task.wait(0.1)
            end
            
            SpawnBlobman()
            return
        end

        if humanoid.SeatPart then return end

        local seat = blobman:FindFirstChild("VehicleSeat")
        if seat then
            local distance = (root.Position - seat.Position).Magnitude

            if distance > 10 then
                root.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
            else
                seat:Sit(humanoid)
            end
        end
    end)
end

