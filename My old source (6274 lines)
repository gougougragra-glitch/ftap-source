local function IsGrabbing()
    if workspace:FindFirstChild("GrabParts") then return true end
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Tool") then return true end
    return false
end

local function GetRandomBodyPart(character)
    local availableParts = {}
    for _, partName in ipairs(BodyParts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then table.insert(availableParts, part) end
    end
    if #availableParts > 0 then return availableParts[math.random(1, #availableParts)] end
    return character:FindFirstChild("HumanoidRootPart")
end

local function GetClosestPlayerForLock()
    local closestPlayer = nil
    local shortestDistance = MaxLockDistance
    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    
    if not myHRP then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
                local distance = (myHRP.Position - targetHRP.Position).Magnitude
                if distance < shortestDistance then
                    local directionToTarget = (targetHRP.Position - Camera.CFrame.Position).Unit
                    local cameraLookDirection = Camera.CFrame.LookVector
                    local dotProduct = cameraLookDirection:Dot(directionToTarget)
                    
                    if dotProduct > 0.4 then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

