function formecomplet.isTargetInPlot()
    if tick() - FormS.lastPlotCheckTime < 0.5 then return FormS.plotCheckCache end
    FormS.lastPlotCheckTime = tick()
    local plotItems = workspace:FindFirstChild("PlotItems")
    if not plotItems then FormS.plotCheckCache = false return false end
    local function check(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child.Name == FormS.selectedTarget then return true end
            if check(child) then return true end
        end
        return false
    end
    FormS.plotCheckCache = check(plotItems)
    return FormS.plotCheckCache
end

function formecomplet.tpAllParts(targetChar, positions)
    for _, partName in pairs(formecomplet.R6Parts) do
        local part = targetChar:FindFirstChild(partName)
        if part and positions[partName] then
            part.CFrame = positions[partName]
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

function formecomplet.restoreCollision()
    if not FormS.selectedTarget or FormS.selectedTarget == "..." then return end
    local targetChar = workspace:FindFirstChild(FormS.selectedTarget)
    if not targetChar then return end
    for _, pn in pairs({"Torso","Head","Left Arm","Right Arm","Left Leg","Right Leg"}) do
        local p = targetChar:FindFirstChild(pn)
        if p then
            p.CanCollide = true
            local rl = p:FindFirstChild("RagdollLimbPart")
            if rl then rl.CanCollide = true end
        end
    end
end

function formecomplet.getRagdoll()
    local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not f then return nil end
    return f:FindFirstChild("ragdoll1")
end

function formecomplet.waitForRagdoll()
    local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    while not f do
        if not FormS.active then return nil end
        task.wait(0.1)
        f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end
    local r = f:FindFirstChild("ragdoll1")
    while not r do
        if not FormS.active then return nil end
        task.wait(0.1)
        r = f:FindFirstChild("ragdoll1")
    end
    return r
end

function formecomplet.destroyRagdoll()
    local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not f then return end
    local r = f:FindFirstChild("ragdoll1")
    if r then
        game:GetService("ReplicatedStorage"):WaitForChild("MenuToys"):WaitForChild("DestroyToy"):FireServer(r)
    end
end

function formecomplet.stopTPLoop()
    if FormS.tpL then FormS.tpL:Disconnect() FormS.tpL = nil end
    if FormS.tpLoop then task.cancel(FormS.tpLoop) FormS.tpLoop = nil end
end

function formecomplet.stopEverything()
    FormS.active = false
    FormS.resp = false
    formecomplet.stopTPLoop()
    if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
end

function formecomplet.startTPLoop()
    formecomplet.stopTPLoop()

    local cachedRagdoll = formecomplet.getRagdoll()
    if cachedRagdoll then
        local sp = cachedRagdoll:FindFirstChild("SoundPart")
        if sp and sp:IsA("BasePart") then
            sp.CanCollide = false
            sp.Transparency = 1
            sp.CFrame = CFrame.new(0, 10e10, 0)
        end
    end

    FormS.tpL = game:GetService("RunService").Heartbeat:Connect(function()
        if not FormS.active then return end

        if not cachedRagdoll or not cachedRagdoll.Parent then
            cachedRagdoll = formecomplet.getRagdoll()
        end
        local r = cachedRagdoll
        if not r then return end

        local sp = r:FindFirstChild("SoundPart")
        if not sp or not sp:IsA("BasePart") then return end
        sp.CanCollide = false
        sp.CanQuery = false
        sp.Transparency = 1
        sp.AssemblyLinearVelocity = Vector3.new(0, 100, 0)

        if not FormS.selectedTarget or FormS.selectedTarget == "..." then return end
        local targetChar = workspace:FindFirstChild(FormS.selectedTarget)
        if not targetChar then return end

        local head = targetChar:FindFirstChild("Head")
        local torso = targetChar:FindFirstChild("Torso")
        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
        if torso then torso.CanCollide = false end
        if head then head.CanCollide = false end
        for _, pn in pairs({"Left Arm","Right Arm","Left Leg","Right Leg"}) do
            local p = targetChar:FindFirstChild(pn)
            if p then
                p.CanCollide = false
                local rl = p:FindFirstChild("RagdollLimbPart")
                if rl then rl.CanCollide = false end
            end
        end

        if not head or not hrp then return end
        local partOwner = head:FindFirstChild("PartOwner")
        if not partOwner then return end

        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(hrp, hrp.CFrame)
        end)

        if tostring(partOwner.Value) == LocalPlayer.Name then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                hrp.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
            end
        end

        local formFunc = formecomplet.forms[FormS.selectedForm] or formecomplet.forms["Normal"]
        if formFunc then
            formecomplet.tpAllParts(targetChar, formFunc(hrp.CFrame))
        end
    end)

    FormS.tpLoop = task.spawn(function()
        while FormS.active do
            task.wait(0.3)
            if not FormS.active then break end
            if not FormS.selectedTarget or FormS.selectedTarget == "..." then continue end
            local targetChar = workspace:FindFirstChild(FormS.selectedTarget)
            if not targetChar then continue end
            local tHead = targetChar:FindFirstChild("Head")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            if not tHead or not hrp then continue end
            local po = tHead:FindFirstChild("PartOwner")
            if not po or tostring(po.Value) ~= LocalPlayer.Name then continue end

            if not cachedRagdoll or not cachedRagdoll.Parent then
                cachedRagdoll = formecomplet.getRagdoll()
            end
            local r = cachedRagdoll
            if not r then continue end

            local sp = r:FindFirstChild("SoundPart")
            if not sp or not sp:IsA("BasePart") then continue end
            sp.CanCollide = false
            sp.CanQuery = false
            sp.Transparency = 1
            sp.CFrame = hrp.CFrame

            task.wait(0.01)
            if not FormS.active then break end
            sp.CFrame = CFrame.new(0, 10e10, 0)
        end
    end)
end

function formecomplet.spawnAndSetup()
    if FormS.resp then return end
    FormS.resp = true

    if FormS.selectedTarget and FormS.selectedTarget ~= "..." then
        if formecomplet.isTargetInPlot() then
            Rayfield:Notify({Title="Cible dans un plot", Content="En attente que " .. FormS.selectedTarget .. " sorte...", Duration=3})
            while formecomplet.isTargetInPlot() do
                if not FormS.active then FormS.resp = false return end
                task.wait(0.5)
            end
            if not FormS.active then FormS.resp = false return end
            Rayfield:Notify({Title="Cible sortie!", Content="Démarrage...", Duration=2})
        end
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    local folder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    local existing = {}
    if folder then
        for _, obj in ipairs(folder:GetChildren()) do
            if obj.Name == "PalletLightBrown" then existing[obj] = true end
        end
    end

    task.spawn(function()
        game:GetService("ReplicatedStorage"):WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction"):InvokeServer("PalletLightBrown", root.CFrame * CFrame.new(0, 10, 20), Vector3.new(0, 0, 0))
    end)

    local fw = 0
    while not folder and fw < 5 do
        if not FormS.active then FormS.resp = false return end
        task.wait(0.1) fw = fw + 0.1
        folder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end
    if not folder then
        FormS.resp = false
        Rayfield:Notify({Title="Erreur", Content="Dossier introuvable.", Duration=3})
        return
    end

    local newPallet, wt = nil, 0
    while not newPallet and wt < 5 do
        if not FormS.active then FormS.resp = false return end
        task.wait(0.1) wt = wt + 0.1
        for _, obj in ipairs(folder:GetChildren()) do
            if obj.Name == "PalletLightBrown" and not existing[obj] then
                newPallet = obj break
            end
        end
    end
    if not newPallet then
        FormS.resp = false
        Rayfield:Notify({Title="Erreur", Content="PalletLightBrown introuvable.", Duration=3})
        return
    end

    newPallet.Name = "ragdoll1"

    local ragdoll1 = formecomplet.waitForRagdoll()
    if not ragdoll1 then FormS.resp = false return end

    for _, child in pairs(ragdoll1:GetDescendants()) do
        if child:IsA("BasePart") then
            child.Transparency = 1
            child.CanCollide = false
            child.CanQuery = false
        end
    end

    task.wait(0.1)
    if not FormS.active then FormS.resp = false return end

    local sp = ragdoll1:FindFirstChild("SoundPart")
    if not sp or not sp:IsA("BasePart") then
        FormS.resp = false
        Rayfield:Notify({Title="Erreur", Content="SoundPart introuvable.", Duration=3})
        return
    end

    task.spawn(function()
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(sp, sp.CFrame)
        end)
    end)

    task.wait(0.1)
    if not FormS.active then FormS.resp = false return end

    formecomplet.startTPLoop()
    FormS.resp = false

    if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
    FormS.watch = ragdoll1.AncestryChanged:Connect(function(_, parent)
        if not FormS.active then return end
        if parent == nil then
            formecomplet.stopTPLoop()
            if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
            FormS.resp = false
            Rayfield:Notify({Title="Planche détruite!", Content="Respawn en cours...", Duration=2})
            task.wait(0.5)
            if FormS.active then task.spawn(function() formecomplet.spawnAndSetup() end) end
        end
    end)

    Rayfield:Notify({Title="Actif!", Content="Système prêt.", Duration=3})

    task.wait(0.1)
    if not FormS.active then return end

    FormS.keepInFrontRunning = false
    task.wait(0)
    FormS.keepInFrontRunning = true

    task.spawn(function()
        local lastTarget = nil
        local cachedChar = nil
        local cachedHRP = nil
        local cachedHead = nil
        local cachedMyHRP = nil

        while FormS.keepInFrontRunning and FormS.isEnabled do
            task.wait(0.05)
            if not FormS.isEnabled or not FormS.keepInFrontRunning then break end
            if not FormS.selectedTarget or FormS.selectedTarget == "..." then continue end

            local myChar = LocalPlayer.Character
            if not myChar then continue end
            if not cachedMyHRP or not cachedMyHRP.Parent then
                cachedMyHRP = myChar:FindFirstChild("HumanoidRootPart")
            end
            if not cachedMyHRP then continue end

            local targetPlayer = Players:FindFirstChild(FormS.selectedTarget)
            if not targetPlayer then continue end

            local currentChar = targetPlayer.Character
            if not currentChar then continue end

            if lastTarget ~= FormS.selectedTarget or cachedChar ~= currentChar then
                lastTarget = FormS.selectedTarget
                cachedChar = currentChar
                cachedHRP = nil
                cachedHead = nil
                FormS.lastPlotCheckTime = 0
            end

            if not cachedHRP or not cachedHRP.Parent then cachedHRP = currentChar:FindFirstChild("HumanoidRootPart") end
            if not cachedHead or not cachedHead.Parent then cachedHead = currentChar:FindFirstChild("Head") end
            if not cachedHRP or not cachedHead then continue end

            if formecomplet.isTargetInPlot() then continue end

            local po = cachedHead:FindFirstChild("PartOwner")
            local isGrabbed = po and tostring(po.Value) == LocalPlayer.Name

            if isGrabbed then
                cachedHRP.AssemblyLinearVelocity = Vector3.zero
                cachedHRP.AssemblyAngularVelocity = Vector3.zero
            else
                local dist = (cachedMyHRP.Position - cachedHRP.Position).Magnitude

                if dist > 20 then
                    if not FormS.isBringing then
                        FormS.isBringing = true
                        local savedPos = cachedMyHRP.CFrame

                        task.spawn(function()
                            local bringConn
                            bringConn = game:GetService("RunService").Heartbeat:Connect(function()
                                if not FormS.isEnabled or not FormS.isBringing then
                                    bringConn:Disconnect()
                                    return
                                end
                                if cachedHRP and cachedHRP.Parent then
                                    cachedMyHRP.CFrame = cachedHRP.CFrame + Vector3.new(0, 3, 0)
                                end
                            end)

                            while FormS.isEnabled do
                                pcall(function()
                                    game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(cachedHRP, cachedHRP.CFrame)
                                end)
                                task.wait(0)
                                local p2 = cachedHead and cachedHead:FindFirstChild("PartOwner")
                                if p2 and tostring(p2.Value) == LocalPlayer.Name then
                                    bringConn:Disconnect()
                                    task.wait(0.1)
                                    cachedMyHRP.CFrame = savedPos
                                    task.wait(0.15)
                                    FormS.isBringing = false
                                    break
                                end
                            end

                            bringConn:Disconnect()
                            FormS.isBringing = false
                        end)
                    end
                else
                    pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(cachedHRP, cachedHRP.CFrame)
                    end)
                end
            end
        end

        FormS.keepInFrontRunning = false
    end)
end

