    formecomplet.stopTPLoop()
    if FormS.watch then FormS.watch:Disconnect() FormS.watch = nil end
end

function formecomplet.startTPLoop()
    formecomplet.stopTPLoop()

    local cachedRagdoll = formecomplet.getRagdoll()
    if cachedRagdoll then
        local sp = cachedRagdoll:FindFirstChild("SoundPart")
        if sp and sp:IsA("BasePart") then
            sp.CanCollide = false
            sp.Transparency = 1
            sp.CFrame = CFrame.new(0, 10e10, 0)
        end
    end

    FormS.tpL = game:GetService("RunService").Heartbeat:Connect(function()
        if not FormS.active then return end

        if not cachedRagdoll or not cachedRagdoll.Parent then
            cachedRagdoll = formecomplet.getRagdoll()
        end
        local r = cachedRagdoll
        if not r then return end

        local sp = r:FindFirstChild("SoundPart")
        if not sp or not sp:IsA("BasePart") then return end
        sp.CanCollide = false
        sp.CanQuery = false
        sp.Transparency = 1
        sp.AssemblyLinearVelocity = Vector3.new(0, 100, 0)

        if not FormS.selectedTarget or FormS.selectedTarget == "..." then return end
        local targetChar = workspace:FindFirstChild(FormS.selectedTarget)
        if not targetChar then return end

        local head = targetChar:FindFirstChild("Head")
        local torso = targetChar:FindFirstChild("Torso")
        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
        if torso then torso.CanCollide = false end
        if head then head.CanCollide = false end
        for _, pn in pairs({"Left Arm","Right Arm","Left Leg","Right Leg"}) do
            local p = targetChar:FindFirstChild(pn)
            if p then
                p.CanCollide = false
                local rl = p:FindFirstChild("RagdollLimbPart")
                if rl then rl.CanCollide = false end
            end
        end

        if not head or not hrp then return end
        local partOwner = head:FindFirstChild("PartOwner")
        if not partOwner then return end

        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(hrp, hrp.CFrame)
        end)

        if tostring(partOwner.Value) == LocalPlayer.Name then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                hrp.CFrame = myHRP.CFrame * CFrame.new(0, 0, -5)
            end
        end

        local formFunc = formecomplet.forms[FormS.selectedForm] or formecomplet.forms["Normal"]
        if formFunc then
            formecomplet.tpAllParts(targetChar, formFunc(hrp.CFrame))
        end
    end)

    FormS.tpLoop = task.spawn(function()
        while FormS.active do
            task.wait(0.3)
            if not FormS.active then break end
            if not FormS.selectedTarget or FormS.selectedTarget == "..." then continue end
            local targetChar = workspace:FindFirstChild(FormS.selectedTarget)
            if not targetChar then continue end
            local tHead = targetChar:FindFirstChild("Head")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            if not tHead or not hrp then continue end
            local po = tHead:FindFirstChild("PartOwner")
            if not po or tostring(po.Value) ~= LocalPlayer.Name then continue end

            if not cachedRagdoll or not cachedRagdoll.Parent then
                cachedRagdoll = formecomplet.getRagdoll()
            end
            local r = cachedRagdoll
            if not r then continue end

            local sp = r:FindFirstChild("SoundPart")
            if not sp or not sp:IsA("BasePart") then continue end
            sp.CanCollide = false
            sp.CanQuery = false
            sp.Transparency = 1
            sp.CFrame = hrp.CFrame

            task.wait(0.01)
            if not FormS.active then break end
            sp.CFrame = CFrame.new(0, 10e10, 0)
        end
    end)
end

function formecomplet.spawnAndSetup()
    if FormS.resp then return end
    FormS.resp = true

    if FormS.selectedTarget and FormS.selectedTarget ~= "..." then
        if formecomplet.isTargetInPlot() then
            while formecomplet.isTargetInPlot() do
