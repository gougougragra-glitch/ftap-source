    local targetHRP = nil
    if GiveEnabled then
        local targetPlayer = Players:FindFirstChild(SelectedPlayerName)
        local targetChar = targetPlayer and targetPlayer.Character
        targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    else
        targetHRP = HumanoidRootPart
    end
    
    if not targetHRP then return end
    
    local activeSticks = GetAllActiveSticks()
    local totalSticks = #activeSticks
    
    if totalSticks > 0 then
        Rotation = Rotation + (SPEED * dt)

        for index, Stick in ipairs(activeSticks) do
            if not Stick.Parent then continue end
            
            local PartOwner = Stick:FindFirstChild("PartOwner")
