-- FLY
local FlySpeed = 50
local FlyToggle = false
local FlyConnection
local Attachment, LinearVelocity, BodyGyro

Tab:CreateSlider({
   Name = "Fly Speed",
   Range = {10, 500},
   Increment = 5,
   Suffix = " Speed",
   CurrentValue = 50,
   Flag = "FlySlider",
   Callback = function(Value)
      FlySpeed = Value
   end,
})

Tab:CreateToggle({
   Name = "Enable Fly",
   CurrentValue = false,
   Flag = "FlyToggle",
   Callback = function(Value)
      FlyToggle = Value
      local player = game.Players.LocalPlayer
      local character = player.Character
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      local rootPart = character and character:FindFirstChild("HumanoidRootPart")

      if not rootPart then return end

      if FlyToggle then
         if humanoid then humanoid.PlatformStand = true end
         Attachment = Instance.new("Attachment", rootPart)

         LinearVelocity = Instance.new("LinearVelocity")
         LinearVelocity.Attachment0 = Attachment
         LinearVelocity.MaxForce = math.huge
         LinearVelocity.VectorVelocity = Vector3.zero
         LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
         LinearVelocity.Parent = rootPart

         BodyGyro = Instance.new("BodyGyro")
         BodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
         BodyGyro.P = 20000
         BodyGyro.CFrame = rootPart.CFrame
         BodyGyro.Parent = rootPart

         FlyConnection = RunService.RenderStepped:Connect(function()
            local camera = workspace.CurrentCamera
            if not rootPart or not character:IsAncestorOf(rootPart) then return end

            local camCF = camera.CFrame
            local userInput = game:GetService("UserInputService")
            local customDir = Vector3.zero

            if userInput:IsKeyDown(Enum.KeyCode.W) or userInput:IsKeyDown(Enum.KeyCode.Z) then customDir = customDir + camCF.LookVector end
            if userInput:IsKeyDown(Enum.KeyCode.S) then customDir = customDir - camCF.LookVector end
            if userInput:IsKeyDown(Enum.KeyCode.D) then customDir = customDir + camCF.RightVector end
            if userInput:IsKeyDown(Enum.KeyCode.A) or userInput:IsKeyDown(Enum.KeyCode.Q) then customDir = customDir - camCF.RightVector end
            if userInput:IsKeyDown(Enum.KeyCode.Space) then customDir = customDir + Vector3.new(0, 1, 0) end
            if userInput:IsKeyDown(Enum.KeyCode.LeftShift) then customDir = customDir - Vector3.new(0, 1, 0) end

            if customDir.Magnitude > 0 then
               LinearVelocity.VectorVelocity = customDir.Unit * FlySpeed
            else
               LinearVelocity.VectorVelocity = Vector3.zero
            end

            BodyGyro.CFrame = camCF
         end)
      else
         if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
         if LinearVelocity then LinearVelocity:Destroy() end
         if BodyGyro then BodyGyro:Destroy() end
         if Attachment then Attachment:Destroy() end
         if humanoid then humanoid.PlatformStand = false end
      end
   end,
})

