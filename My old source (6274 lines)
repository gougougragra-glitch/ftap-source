do
    -- Création de l'onglet et de la section
    local Tab = Window:CreateTab("Keybinds", 4483362458)
    local Section = Tab:CreateSection("Destroy Limbs")

    -- Fonction utilitaire pour supprimer un ou plusieurs membres
    local function RemoveLimbs(limbsTable)
        if workspace:FindFirstChild("GrabParts") and workspace.GrabParts:FindFirstChild("GrabPart") then
            local target = workspace.GrabParts.GrabPart.WeldConstraint.Part1 and workspace.GrabParts.GrabPart.WeldConstraint.Part1.Parent
            if target and target:FindFirstChild("Humanoid") and target.Humanoid:FindFirstChild("Ragdolled") then
                if target.Humanoid.Ragdolled.Value then
                    local pos = target["Torso"].CFrame
                    workspace.FallenPartsDestroyHeight = -100
                    
                    for _, limbName in ipairs(limbsTable) do
                        if target:FindFirstChild(limbName) then
                            target[limbName].CFrame = CFrame.new(0, -1000, 0)
                        end
                    end
                    
                    task.wait(0.1)
                    target["Torso"].CFrame = CFrame.new(0, -950, 0)
                    task.wait(0)
                    target["Torso"].CFrame = pos
                else
                    Rayfield:Notify({
                       Title = "Erreur",
                       Content = "La cible doit être en Ragdoll !",
                       Duration = 3,
                       Image = 4483362458,
                    })
                end
            end
        else
            Rayfield:Notify({
               Title = "Erreur",
               Content = "Attrape quelqu'un d'abord !",
               Duration = 3,
               Image = 4483362458,
            })
        end
    end

    Tab:CreateKeybind({
    Name = "Click TP",
    CurrentKeybind = "T",
    HoldToInteract = false,
    Flag = "ClickTP",
    Callback = function()
        local Mouse = LocalPlayer:GetMouse()
        if not Mouse or not Mouse.Target then return end 

        local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if not HRP then return end

        local MaxDistance = 2000
        local ClickPos = Mouse.Hit.Position
        local Offset = ClickPos - HRP.Position
        local Distance = Offset.Magnitude

        if Distance > MaxDistance then
            ClickPos = HRP.Position + Offset.Unit * MaxDistance
        end

        HRP.CFrame = CFrame.new(ClickPos.X, ClickPos.Y + 3.5, ClickPos.Z)
    end,
})

