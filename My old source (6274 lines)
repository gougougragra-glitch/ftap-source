local function stopAntiGucci(isResetting)
    if not isResetting then
        autoGucciActive = false
    end

    if antiGucciConnection then antiGucciConnection:Disconnect(); antiGucciConnection = nil end
    if blobFlyConnection then blobFlyConnection:Disconnect(); blobFlyConnection = nil end
    if blobDestroyConnection then blobDestroyConnection:Disconnect(); blobDestroyConnection = nil end
    if characterDiedConnection then characterDiedConnection:Disconnect(); characterDiedConnection = nil end

    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = folder and folder:FindFirstChild("CreatureBlobman")

    if blob then
        for _, v in ipairs(blob:GetDescendants()) do
            if v:IsA("BasePart") then
                v.AssemblyLinearVelocity = Vector3.zero
                v.AssemblyAngularVelocity = Vector3.zero
            end
        end

        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(blob)
        end)
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")

    if hum then
        hum.Sit = true
        task.wait(0.05)
        hum.Sit = false
    end
end

startAntiGucci = function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = FWC(char, "Humanoid")
    local hrp = FWC(char, "HumanoidRootPart")
    if not hum or not hrp then return end

    safePosition = hrp.Position
    
    if characterDiedConnection then characterDiedConnection:Disconnect() end
    characterDiedConnection = hum.Died:Connect(function()
        if autoGucciActive then
            stopAntiGucci(true)
            local newChar = LocalPlayer.CharacterAdded:Wait()
            newChar:WaitForChild("HumanoidRootPart", 10)
            task.wait(0.07)
            if autoGucciActive then
                startAntiGucci()
            end
        end
    end)

    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if folder and folder:FindFirstChild("CreatureBlobman") then
        stopAntiGucci(true)
        task.wait(0.05)
    end

    local Blob = toy_spawn()
    if not Blob then 
        if typeof(Rayfield) ~= "nil" then
            Rayfield:Notify({Title = "Erreur", Content = "Impossible de générer le Blobman", Duration = 3})
        end
        return 
    end

    if blobDestroyConnection then blobDestroyConnection:Disconnect() end
    blobDestroyConnection = Blob.AncestryChanged:Connect(function(_, parent)
        if not parent and autoGucciActive then
            blobDestroyConnection:Disconnect()
            blobDestroyConnection = nil
            
            task.spawn(function()
                stopAntiGucci(true)
                task.wait(0.1)
                if autoGucciActive then
                    startAntiGucci()
                end
            end)
        end
    end)

    local Seat = FWC(Blob, "VehicleSeat")
    
    -- Protection anti-siège ennemi instantanée avec notification intégrée
    local seatOccupantConn
    seatOccupantConn = Seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        local occupant = Seat.Occupant
        if occupant and occupant ~= hum then
            seatOccupantConn:Disconnect()
            
            if typeof(Rayfield) ~= "nil" then
                Rayfield:Notify({
                    Title = "Gucci Defense",
                    Content = occupant.Name .. " sat on ur gucci",
                    Duration = 4
                })
            end

            if autoGucciActive then
                task.spawn(function()
                    stopAntiGucci(true)
                    task.wait(0.05)
                    if autoGucciActive then
                        startAntiGucci()
                    end
                end)
            end
        end
    end)

    task.spawn(function()
        local BHead = FWC(Blob, "Head")
        local HitBox = FWC(Blob, "GrabbableHitbox")
        if BHead and HitBox then
            while autoGucciActive and Blob and Blob.Parent do
                local partOwner = BHead:FindFirstChild("PartOwner")
                if not partOwner or (partOwner and partOwner.Value ~= LocalPlayer.Name) then
                    task.spawn(grab, HitBox)
                else
                    break 
                end
                task.wait()
            end
        end
    end)

    local autoGucciT = true
    task.defer(function()
        if not (char or hum) then return end
        local startTime = tick()
        while autoGucciT and autoGucciActive and (tick() - startTime < 0.1) do
            if Blob and Seat and Seat.Occupant ~= hum then 
                Seat:Sit(hum) 
            end
            task.wait(0.05)
            if char and hum then 
                hum:ChangeState(Enum.HumanoidStateType.Jumping) 
            end
            task.wait(0.05)
        end
        autoGucciT = false
    end)

    if antiGucciConnection then antiGucciConnection:Disconnect() end
    antiGucciConnection = RunService.Heartbeat:Connect(function()
        if not hrp or not hum or not autoGucciActive then return end
        ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(hrp, 0.095)
        
        if restoreFrames > 0 then
            hrp.CFrame = CFrame.new(safePosition)
            restoreFrames = restoreFrames - 1
        end
    end)

    task.wait(0.01)
    if hum and Blob and Blob.Parent then
        hum.Sit = false
        
        local BlobSit = Blob:FindFirstChild("VehicleSeat")
        if BlobSit then BlobSit:Destroy() end
        
        local BlobHRP = Blob:FindFirstChild("HumanoidRootPart")
        if BlobHRP then
            grab(BlobHRP)
            task.wait(0.02)

            if blobFlyConnection then blobFlyConnection:Disconnect() end
            blobFlyConnection = RunService.Heartbeat:Connect(function()
                if not autoGucciActive or not BlobHRP or not BlobHRP.Parent then
                    if blobFlyConnection then blobFlyConnection:Disconnect() end
                    if BlobHRP and BlobHRP.Parent then
                        BlobHRP.AssemblyLinearVelocity = Vector3.zero
                        BlobHRP.AssemblyAngularVelocity = Vector3.zero
                    end
                    return
                end

                BlobHRP.AssemblyLinearVelocity = Vector3.new(0, 10000, 0)
                BlobHRP.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

