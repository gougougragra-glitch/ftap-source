local extendLigneScrollConn = nil
local extendLigneDist = 10
local extendLigneStep = 11

local function StartCloneFollow(clone)
    if extendLigneFollowConn then extendLigneFollowConn:Disconnect() end
    extendLigneFollowConn = game:GetService("RunService").RenderStepped:Connect(function()
        if clone and clone.Parent then
            clone.Position = workspace.CurrentCamera.CFrame.Position + workspace.CurrentCamera.CFrame.LookVector * extendLigneDist
        else
            extendLigneFollowConn:Disconnect()
            extendLigneFollowConn = nil
        end
    end)
end

local function StartMouseScrollControl()
    if extendLigneScrollConn then extendLigneScrollConn:Disconnect() end
    extendLigneScrollConn = game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if input.Position.Z > 0 then
                extendLigneDist = extendLigneDist + extendLigneStep
            elseif input.Position.Z < 0 then
