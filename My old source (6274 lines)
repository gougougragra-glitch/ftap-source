                pcall(function() 
                    GrabEvents.SetNetworkOwner:FireServer(Stick, Stick.CFrame) 
                end)
            end
            
            local angleOffset = (index / totalSticks) * (math.pi * 2)
            local currentAngle = Rotation + angleOffset
            
            local Offset = GetShapeOffset(currentAngle)
            
            local TargetCFrame = targetHRP.CFrame * CFrame.new(Offset.X, Offset.Y, Offset.Z)
            
            pcall(function()
                Stick.AssemblyLinearVelocity = Vector3.zero
                Stick.AssemblyAngularVelocity = Vector3.zero
                Stick.CFrame = TargetCFrame
            end)
        end
    end
end)

