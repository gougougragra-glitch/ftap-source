local function ProcessGrabParts()
    local gp = workspace:FindFirstChild("GrabParts") if not gp then return end
    local dragPart = gp:FindFirstChild("DragPart") if not dragPart then return end
    if gp:FindFirstChild("DragPartClone") then return end
    local clone = dragPart:Clone()
    clone.Name = "DragPartClone"
    clone.Parent = gp
    if dragPart:FindFirstChild("AlignPosition") then dragPart.AlignPosition.Enabled = false end
    if clone:FindFirstChild("AlignOrientation") then clone.AlignOrientation.Enabled = false end
    extendLigneDist = (clone.Position - workspace.CurrentCamera.CFrame.Position).Magnitude
    StartCloneFollow(clone)
    StartMouseScrollControl()
end

